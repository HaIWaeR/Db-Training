--
-- TOC entry 225 (class 1259 OID 16441)
-- Name: current_rentals_view; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.current_rentals_view AS
 SELECT r.id AS rental_id,
    si.equipment_name AS inventory_name,
    et.name AS equipment_type,
    r.customer_name,
    r.customer_phone,
    r.rental_start,
    r.rental_end
   FROM ((public.rentals r
     JOIN public.ski_inventory si ON ((r.ski_inventory = si.id)))
     JOIN public.equipment_type et ON ((si.equipment_type = et.id)))
  WHERE (r.actual_return_time IS NULL)
  ORDER BY r.rental_start DESC;


ALTER VIEW public.current_rentals_view OWNER TO postgres;

