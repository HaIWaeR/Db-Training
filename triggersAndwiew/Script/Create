--
-- TOC entry 227 (class 1255 OID 16439)
-- Name: check_equipment_availability(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.check_equipment_availability() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    equipment_status status_enum;
BEGIN

    SELECT status INTO equipment_status
    FROM ski_inventory 
    WHERE id = NEW.ski_inventory;
    
    IF equipment_status IS NULL THEN
        RAISE EXCEPTION 'Cannot create rental: Equipment with ID % does not exist', NEW.ski_inventory;
    END IF;
    
    IF equipment_status != 'available' THEN
        RAISE EXCEPTION 'Cannot create rental: Equipment with ID % is not available. Current status: %', 
                        NEW.ski_inventory, equipment_status;
    END IF;
    
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.check_equipment_availability() OWNER TO postgres;

--
-- TOC entry 226 (class 1255 OID 16438)
-- Name: start_rental(character varying, character varying, integer, integer); Type: PROCEDURE; Schema: public; Owner: postgres
--

CREATE PROCEDURE public.start_rental(IN in_customer_name character varying, IN in_customer_phone character varying, IN in_equipment_id integer, IN in_rental_hours integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    current_equipment_status status_enum;
BEGIN
    SELECT status INTO current_equipment_status
    FROM ski_inventory
    WHERE id = in_equipment_id;

    IF current_equipment_status IS NULL THEN
        RAISE EXCEPTION 'Equipment with ID % does not exist', in_equipment_id;
    END IF;

    IF current_equipment_status != 'available' THEN
        RAISE EXCEPTION 'The equipment is not available for rental. Current status: %', current_equipment_status;
    END IF;

    INSERT INTO rentals (customer_name, customer_phone, rental_start, rental_end, ski_inventory)
    VALUES (
        in_customer_name,
        in_customer_phone,
        NOW(),
        NOW() + INTERVAL '1 hour' * in_rental_hours,
        in_equipment_id
    );

    UPDATE ski_inventory
    SET status = 'rented'
    WHERE id = in_equipment_id;

    RAISE NOTICE 'Rental started successfully for customer % on equipment ID %', in_customer_name, in_equipment_id;

END;
$$;


ALTER PROCEDURE public.start_rental(IN in_customer_name character varying, IN in_customer_phone character varying, IN in_equipment_id integer, IN in_rental_hours integer) OWNER TO postgres;

